# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HireMatch AI

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/hirematch?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage — create a private bucket named "resumes"
# Dashboard → Storage → New bucket → Name: resumes → Public: off
# Policies (SQL editor example):
#   Allow authenticated users to upload/read/delete only their own files under {userId}/

# Supabase Auth redirect URLs (Dashboard → Authentication → URL Configuration)
# Site URL: http://localhost:3000
# Redirect URLs: http://localhost:3000/auth/callback

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Resend
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=HireMatch AI <noreply@hirematch.ai>
